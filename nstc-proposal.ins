\generate{\file{example/proposal.tex}{\from{\jobname.dtx}{proposal.tex}}
          \file{example/bibliography.tex}{\from{\jobname.dtx}{bibliography.tex}}
          \file{nstc-cm03.cls}{\from{\jobname.dtx}{cm03}}
